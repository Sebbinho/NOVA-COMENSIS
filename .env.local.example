# Rinomina questo file in .env.local e inserisci i tuoi valori

# Ottieni una API key su https://console.cloud.google.com/
# Abilita "Places API" per il tuo progetto
GOOGLE_PLACES_API_KEY=

# Il Place ID della tua attività (lo trovi su:
# https://developers.google.com/maps/documentation/places/web-service/place-id)
GOOGLE_PLACE_ID=

# Stesso Place ID, ma esposto al browser per il link "Lascia una recensione"
NEXT_PUBLIC_GOOGLE_PLACE_ID=
